DATABASE_URL_MAIN=postgresql://user:pass@host:5432/dealflow_crm?connection_limit=20&pool_timeout=30
# DealFlow's database, read only by src/lib/core-data/dealflow-sync/ro-client.ts
# (one SELECT/WITH at a time, each inside a READ ONLY transaction).
DATABASE_URL_DEALFLOW_RO=postgresql://readonly:pass@host:5432/railway
# Perf DB — name MUST end in _perf (seed + perf scripts refuse any other DB)
DATABASE_URL_PERF=postgresql://user:pass@host:5432/dealflow_crm_perf
# One-off scripts/bootstrap-databases.ts only (already ran): the Railway server's
# admin address. Leave blank; set it in the shell for that one run, never in Vercel.
DATABASE_URL_ADMIN=
# Job key for the cron routes (Authorization: Bearer <key>). Set the real one in
# Vercel only, never here (e.g. openssl rand -hex 32). Unset, every cron refuses.
CRON_SECRET=
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
# Agent A
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_IMPORTS=dealflow-crm-imports
# Compliance (Agent C) — mock during isolated build; real service at integration
COMPLIANCE_BASE_URL=http://localhost:5555
COMPLIANCE_CALLABLE_BATCH_SIZE=100
# DealFlow sync: 1 for pure-isolation runs (fixture rows, no RO DB)
DEALFLOW_SYNC_STUB=0
# pg-boss: 1 to run importer commit as a retryable background job
USE_PGBOSS=0
# Agent B (fill in in that worktree)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_APP_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_CALLER_ID_NUMBER=
TWILIO_VOICE_WEBHOOK_BASE=
TWILIO_RECORDING_STATUS_CALLBACK=
R2_BUCKET_RECORDINGS=dealflow-crm-recordings
# Soft rail; brief §5 authoritative default is 200 (was 500 scaffold drift).
TWILIO_MONTHLY_SPEND_CAP_USD=200
# Agent B — telephony runtime (defaults; brief §5)
RING_TIMEOUT_SECONDS=19
PACING_INTERVAL_SECONDS=60
# Dropped-loser message seam — Ryan flips these WITHOUT a code change.
RACE_LOSER_TWIML_MODE=say
RACE_LOSER_TWIML_TEXT=Sorry, our agent just stepped away. We'll call you back shortly.
RACE_LOSER_TWIML_MP3_URL=
# Predictive-dial safety gate: must be 'true' before method=predictive sessions
# are allowed to start (belt+suspenders for FCC abandoned-call rules).
LOSER_TWIML_APPROVED=false
# Cross-slice service URLs — point at local mocks during Milestones 1–3, swap to
# real Agent A / Agent C URLs at integration.
QUEUE_SERVICE_BASE_URL=http://localhost:4101
# Named COMPLIANCE_BASE_URL to match Agent A's shipped name (fleet convergence).
COMPLIANCE_BASE_URL=http://localhost:4102
# Agent C (Ryan will fill vendor keys)
DNC_VENDOR=
DNC_API_KEY=
LITIGATOR_VENDOR=
LITIGATOR_API_KEY=
MOBILE_LINE_VENDOR=twilio_lookup
NYC_TIMEZONE_DEFAULT=America/New_York
# Agent D — Communications
# SMS (Twilio Messaging + 10DLC) — parked until the campaign is APPROVED
SMS_ENABLED=false
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_10DLC_BRAND_ID=
TWILIO_10DLC_CAMPAIGN_ID=
# Gmail OAuth — Agent D's OWN app (NOT DealFlow's read-only Graph token).
# Ryan fills these from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://<domain>/api/comms/oauth/gmail/callback
# Gmail push notifications (Pub/Sub)
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_VERIFICATION_TOKEN=
# Microsoft Graph OAuth — own app (Milestone 5)
MSFT_GRAPH_CLIENT_ID=
MSFT_GRAPH_CLIENT_SECRET=
MSFT_GRAPH_TENANT_ID=common
MSFT_GRAPH_REDIRECT_URI=https://<domain>/api/comms/oauth/msft/callback
OAUTH_REDIRECT_BASE=
# Brief 41.2 — Outlook / Microsoft Graph off-switch. Same name as DealFlow's
# (confirmed by Ryan 2026-10-17).
# Ryan's instruction: Outlook stays on hard pause, so leave this UNSET. Only the
# exact value 'true' turns Outlook on (an engineering precaution, like the other
# switches); anything else (unset, empty, TRUE, 1) keeps the Outlook sign-in,
# token refresh, mail sync and sending off.
GRAPH_ENABLED=
# OAuth security (Agent D)
OAUTH_STATE_SECRET=            # HMAC secret for CSRF-safe OAuth `state`
OAUTH_TOKEN_ENCRYPTION_KEY=    # base64 32 bytes — generate: openssl rand -base64 32
PG_BOSS_SCHEMA=pgboss

# --- App access gate (HTTP Basic auth) ---------------------------------------
# Lightweight "keep the public out" gate for the Vercel deploy. Not a real
# identity system — no users, no sessions. See src/lib/auth/basicAuth.ts.
#
# BASIC_AUTH_PASSWORD UNSET or empty => the gate is DISABLED (no prompt). This
# is the intended local-dev and E2E setup. Set it to enable the gate on every
# route except the webhook/cron exemptions listed in basicAuth.ts.
# BASIC_AUTH_USER defaults to "ryan" when unset.
#
# BASIC_AUTH_USER and BASIC_AUTH_PASSWORD are inlined at Vercel BUILD time
# by Next.js's Edge runtime. Consequences:
#   (1) they must be set in Vercel env vars BEFORE the first deploy —
#       deploying without them ships an unprotected build.
#   (2) rotating the password requires a redeploy, not just an env var update.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
